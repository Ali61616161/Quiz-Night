# Uygulama
NEXT_PUBLIC_APP_NAME=Quizhane
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kalıcı veri klasörü (hesaplar, içerik, geçmiş). Üretimde kalıcı bir diske bağla.
DATA_DIR=.data
RETENTION_DAYS=30

# Süper admin e-postaları (virgülle). Boşsa admin paneli kimseye açılmaz.
ADMIN_EMAILS=

# Zamanlanmış işler için gizli anahtar (en az 16 karakter). /api/cron/* uçları bunu ister.
CRON_SECRET=

# E-posta (Resend). Tanımlı değilse e-posta gönderilmez; doğrulama/sıfırlama çalışmaz.
RESEND_API_KEY=
MAIL_FROM=Quizhane <no-reply@alanadiniz.com>
SUPPORT_EMAIL=destek@alanadiniz.com

# AI soru üretimi
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Ödeme: fake (varsayılan, yerel test) ya da iyzico (iskelet)
BILLING_PROVIDER=fake
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Yalnızca test: doğrulama/sıfırlama bağlantılarını API yanıtında göster. ÜRETİMDE KULLANMA.
EXPOSE_DEV_LINKS=

# Supabase (şema supabase/migrations içinde, uygulama henüz bağlı değil)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
